filters:
  and:
    - tipo == "proyecto"
    - file.folder != "00_Reglas_y_Estandares/templates"
properties:
  estado:
    displayName: Estado
  actualizado:
    displayName: Actualizado
views:
  - type: table
    name: Todos por estado
    order:
      - file.name
      - estado
      - actualizado
      - tags
    sort:
      - property: actualizado
        direction: DESC
    group_by: estado
  - type: table
    name: Activos
    filters:
      and:
        - estado == "activo"
    order:
      - file.name
      - actualizado
      - tags
